# ==========================================
# APP CONFIGURATION (White Label Ready)
# ==========================================
APP_NAME="Marketing Agency SaaS"
APP_ENV="development"
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Development (SQLite)
DATABASE_URL="sqlite:///./database/dev_saas.db"

# Production (PostgreSQL - Future use)
# DATABASE_URL="postgresql://user:password@localhost:5432/saas_db"

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
# Generate a secure key later using: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# EXTERNAL APIs (Future Ready)
# ==========================================
OPENAI_API_KEY=""
GEMINI_API_KEY=""
RESEND_API_KEY="" # For transactional emails
CLOUDINARY_URL="" # For image uploads